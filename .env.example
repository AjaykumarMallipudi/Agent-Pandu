# ─────────────────────────────────────────────────────────────
# Smart Applytick — copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Server. Keep HOST=127.0.0.1 unless you have set ADMIN_TOKEN and ALLOWED_HOSTS.
HOST=127.0.0.1
PORT=4000
# Required if HOST is not loopback. Sent as "Authorization: Bearer <token>".
ADMIN_TOKEN=
# Extra Host header values to accept (comma-separated), e.g. applytick.example.com
ALLOWED_HOSTS=
DATA_DIR=data
# DATABASE_PATH=data/applytick.db
LOG_LEVEL=info

# ── Company discovery ────────────────────────────────────────
# osm (free, default) or google_places (optional, paid)
DISCOVERY_PROVIDER=osm
# OpenStreetMap: no API key. Your real email is required by the Nominatim/Overpass usage policies;
# it is sent only in the User-Agent and the Nominatim "email" parameter.
OSM_CONTACT_EMAIL=you@example.com
# Public endpoints (change only to use another Overpass instance or your own Nominatim server).
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional. Google Cloud Console → enable "Places API (New)" → create a key restricted to that API.
GOOGLE_PLACES_API_KEY=

# ── Crawler politeness / safety ──────────────────────────────
CRAWL_USER_AGENT=SmartApplytickBot/1.0 (+public contact discovery; respects robots.txt)
CRAWL_TIMEOUT_MS=10000
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_REDIRECTS=5
CRAWL_HOST_DELAY_MS=1500
CRAWL_CONCURRENCY=3
CRAWL_CHECK_MX=true

# ── SMTP (Nodemailer) ────────────────────────────────────────
# Gmail example: smtp.gmail.com / 465 / SMTP_SECURE=true / an App Password (not your login password).
# Microsoft 365: smtp.office365.com / 587 / SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SENDER_NAME=
SENDER_PHONE=
SENDER_LINKEDIN=
SENDER_GITHUB=
SENDER_PORTFOLIO=
# Where "Send test" in the template editor delivers. Use your own inbox.
TEST_EMAIL_ADDRESS=

# ── Sending safety ───────────────────────────────────────────
# true = campaign messages are built but never transmitted. Cannot be turned off from the UI while true here.
EMAIL_TEST_MODE=true
# true = no message of any kind is submitted. Cannot be released from the UI while true here.
SENDING_KILL_SWITCH=false
# Hard caps; the UI can only lower these.
SEND_RATE_PER_MINUTE=10
SEND_DAILY_LIMIT=200
SEND_CONCURRENCY=1
SEND_MAX_ATTEMPTS=3
# 50 or 100 (UI can switch between them)
MAX_RECIPIENTS_PER_CAMPAIGN=50
MIN_CONFIDENCE=40
WORKER_POLL_MS=1000

# ── Optional ─────────────────────────────────────────────────
# Public URL where /unsubscribe/<token> is reachable. Without it, emails ask recipients to reply "unsubscribe".
PUBLIC_BASE_URL=
# Shared secret for POST /api/webhooks/delivery (delivery/bounce/complaint evidence from your provider).
WEBHOOK_SECRET=
