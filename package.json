{
  "name": "smart-applytick",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "db:init": "npm run db:init -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
